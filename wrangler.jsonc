// Download page served as static assets by a Cloudflare Worker.
// Deployed by .github/workflows/release.yml through tool/deploy_download.sh,
// which adds the APK and version.json and overrides --assets. Keep Cloudflare
// Git builds off: they would redeploy download/site without the APK.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tchip-cash",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "download/site",
    "not_found_handling": "404-page"
  }
}
